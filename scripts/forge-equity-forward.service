[Unit]
Description=Forge autonomous equity forward paper experiments
After=network-online.target forge.service

[Service]
Type=oneshot
User=forge
Group=forge
EnvironmentFile=/etc/forge/forge.env
WorkingDirectory=/srv/forge
ExecStart=/srv/forge/.venv/bin/python -m forge.research.autonomous_equity
TimeoutStartSec=90
CPUQuota=20%
MemoryMax=256M
Nice=15
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/forge/var
ProtectHome=true
PrivateTmp=true
UMask=0077
